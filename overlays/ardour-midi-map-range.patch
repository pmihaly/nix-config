 bool
+GenericMidiControlProtocol::map_midi_range (std::weak_ptr<Controllable> weak_control, float low, float high)
+{
+	auto control = weak_control.lock ();
+	if (!control) {
+		return false;
+	}
+	PBD::Mutex::Lock lock (controllables_lock);
+	bool changed = false;
+	for (auto i = controllables.begin (); i != controllables.end (); ++i) {
+		if ((*i)->get_controllable () != control || !(*i)->learned ()) {
+			continue;
+		}
+		(*i)->set_learned_range (low, high);
+		changed = true;
+	}
+	lock.release ();
+	if (changed) {
+		session->set_dirty ();
+	}
+	return changed;
+}

+void
+PlugUIBase::preview_midi_mapping_value (std::shared_ptr<Controllable> control, float iface)
+{
+	if (!control) {
+		return;
+	}
+
+	control->set_value (control->interface_to_internal (iface), Controllable::UseGroup);
+}
+
+std::string
+PlugUIBase::midi_mapping_value_string (std::shared_ptr<Controllable> control, float iface)
+{
+	auto actl = std::dynamic_pointer_cast<AutomationControl> (control);
+	if (actl) {
+		return ARDOUR::value_as_string (actl->desc (), actl->interface_to_internal (iface));
+	}
+	return std::to_string (iface);
+}
+
+void
+PlugUIBase::build_midi_mapping_row (std::shared_ptr<Controllable> control, std::string const& target, std::string const& source, float low, float high)
+{
+	if (!control) {
+		return;
+	}
+
+	Gtk::VBox* card = Gtk::manage (new Gtk::VBox (false, 2));
+
+	Gtk::HBox* header = Gtk::manage (new Gtk::HBox (false, 4));
+	Gtk::Label* target_label = Gtk::manage (new Gtk::Label (target));
+	target_label->set_alignment (0.0, 0.5);
+	target_label->set_ellipsize (Pango::ELLIPSIZE_END);
+	header->pack_start (*target_label, true, true, 0);
+	Gtk::Label* source_label = Gtk::manage (new Gtk::Label (source));
+	source_label->set_alignment (1.0, 0.5);
+	header->pack_start (*source_label, false, false, 4);
+	Gtk::Button* remove = Gtk::manage (new Gtk::Button (_("Remove")));
+	/* defer: remove_midi_mapping() rebuilds the rows and thereby deletes this
+	 * very button, which is not safe from inside its own clicked handler */
+	remove->signal_clicked ().connect ([this, control] {
+		Glib::signal_idle ().connect_once ([this, control] { remove_midi_mapping (control); });
+	});
+	header->pack_end (*remove, false, false, 4);
+
+	Gtk::HBox* low_row = Gtk::manage (new Gtk::HBox (false, 4));
+	Gtk::Label* low_name = Gtk::manage (new Gtk::Label (_("MIDI 0:")));
+	low_name->set_alignment (0.0, 0.5);
+	low_name->set_size_request (72, -1);
+	Gtk::HScale* low_scale = Gtk::manage (new Gtk::HScale (0.0, 1.0, 0.001));
+	low_scale->set_draw_value (false);
+	low_scale->set_size_request (220, -1);
+	low_scale->set_value (low);
+	Gtk::Label* low_value = Gtk::manage (new Gtk::Label (midi_mapping_value_string (control, low)));
+	low_value->set_alignment (0.0, 0.5);
+	low_value->set_size_request (110, -1);
+	low_row->pack_start (*low_name, false, false);
+	low_row->pack_start (*low_scale, true, true);
+	low_row->pack_start (*low_value, false, false);
+
+	Gtk::HBox* high_row = Gtk::manage (new Gtk::HBox (false, 4));
+	Gtk::Label* high_name = Gtk::manage (new Gtk::Label (_("MIDI 127:")));
+	high_name->set_alignment (0.0, 0.5);
+	high_name->set_size_request (72, -1);
+	Gtk::HScale* high_scale = Gtk::manage (new Gtk::HScale (0.0, 1.0, 0.001));
+	high_scale->set_draw_value (false);
+	high_scale->set_size_request (220, -1);
+	high_scale->set_value (high);
+	Gtk::Label* high_value = Gtk::manage (new Gtk::Label (midi_mapping_value_string (control, high)));
+	high_value->set_alignment (0.0, 0.5);
+	high_value->set_size_request (110, -1);
+	high_row->pack_start (*high_name, false, false);
+	high_row->pack_start (*high_scale, true, true);
+	high_row->pack_start (*high_value, false, false);
+
+	/* Dragging an endpoint previews it: the parameter is moved to exactly the
+	 * value that endpoint produces (the same computation, and the same group
+	 * disposition, as the MIDI knob itself), so the value can be dialled in by
+	 * ear/eye. set_value() here only fires on user drags, never on the
+	 * initial set_value() above. */
+	low_scale->signal_value_changed ().connect ([this, control, low_scale, low_value, high_scale] {
+		const float pos = low_scale->get_value ();
+		low_value->set_text (midi_mapping_value_string (control, pos));
+		Controllable::MapMidiRange (control, pos, high_scale->get_value ());
+		preview_midi_mapping_value (control, pos);
+	});
+	high_scale->signal_value_changed ().connect ([this, control, high_scale, high_value, low_scale] {
+		const float pos = high_scale->get_value ();
+		high_value->set_text (midi_mapping_value_string (control, pos));
+		Controllable::MapMidiRange (control, low_scale->get_value (), pos);
+		preview_midi_mapping_value (control, pos);
+	});
+
+	card->pack_start (*header, false, false);
+	card->pack_start (*low_row, false, false);
+	card->pack_start (*high_row, false, false);
+
+	_midi_rows.pack_start (*card, false, false);
 }
 

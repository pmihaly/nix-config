+GenericMidiControlProtocol::midi_bindings (std::vector<Controllable::MidiBinding>& bindings)
+{
+	PBD::Mutex::Lock lock (controllables_lock);
+	for (auto const& mapping : controllables) {
+		auto control = mapping->get_controllable ();
+		if (!control || !mapping->learned ()) {
+			continue;
+		}
+		std::string message = string_compose (_("Event %1 / %2"), (int) mapping->get_control_type (), (int) mapping->get_control_additional ());
+		if (mapping->get_control_type () == MIDI::controller) {
+			message = string_compose (_("CC %1"), (int) mapping->get_control_additional ());
+		}
+		if (mapping->get_control_type () == MIDI::pitchbend) {
+			message = _("Pitch bend");
+		}
+		bindings.push_back ({control, string_compose (_("Ch %1 / %2"), (int) mapping->get_control_channel () + 1, message)});
+	}
+}
+
+bool
+GenericMidiControlProtocol::unmap_midi (std::weak_ptr<Controllable> weak_control)
+{
+	auto control = weak_control.lock ();
+	if (!control) {
+		return false;
+	}
+	stop_learning (weak_control);
+	PBD::Mutex::Lock lock (controllables_lock);
+	bool removed = false;
+	for (auto i = controllables.begin (); i != controllables.end ();) {
+		if ((*i)->get_controllable () != control || !(*i)->learned ()) {
+			++i;
+			continue;
+		}
+		delete *i;
+		i = controllables.erase (i);
+		removed = true;
+	}
+	lock.release ();
+	if (removed) {
+		session->set_dirty ();
+		Controllable::MidiBindingsChanged ();
+	}
+	return true;
+}

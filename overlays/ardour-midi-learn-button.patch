+void
+RouteTimeAxisView::hide_automation_lane (std::shared_ptr<AutomationControl> control)
+{
+	if (!control) {
+		return;
+	}
+	Gtk::CheckMenuItem* item = find_menu_item_by_ctrl (control);
+	if (item && item->get_active ()) {
+		item->set_active (false);
+	}
+	std::shared_ptr<AutomationTimeAxisView> lane = find_atav_by_ctrl (control, false);
+	if (lane && lane->set_marked_for_display (false)) {
+		request_redraw ();
+	}
+}
+
+bool
+RouteTimeAxisView::show_automation_lane (std::shared_ptr<AutomationControl> control)
+{
+	if (!control) {
+		return false;
+	}
+
+	Gtk::CheckMenuItem* item = find_menu_item_by_ctrl (control);
+	if (item) {
+		item->set_active (true);
+	}
+
+	std::shared_ptr<AutomationTimeAxisView> lane = find_atav_by_ctrl (control, false);
+	if (!lane) {
+		return false;
+	}
+	if (lane->set_marked_for_display (true)) {
+		request_redraw ();
+	}
+	return true;
+}

 void
+PlugUIBase::remember_touched_parameter (std::weak_ptr<Controllable> touched)
+{
+	std::shared_ptr<AutomationControl> control = std::dynamic_pointer_cast<AutomationControl> (touched.lock ());
+	if (!_pi || !control || control->parameter ().type () != PluginAutomation) {
+		return;
+	}
+	if (!(control->flags () & Controllable::NotAutomatable) && !midi_mapping_target (control).empty ()) {
+		if (_last_midi_parameter.lock () != control) {
+			_last_midi_parameter = control;
+			refresh_midi_last_tweaked ();
+			if (_midi_dialog && _midi_dialog->get_visible ()) {
+				open_last_tweaked_group ();
+			}
+		}
+	}
+	if (_pi->automation_control (control->parameter (), false) != control) {
+		return;
+	}
+	if (_learn_binding.get_controllable () == control) {
+		return;
+	}
+
+	_learn_binding.set_controllable (control);
+	_learn_button.set_sensitive (true);
+	set_tooltip (_learn_button, string_compose (_("Show automation lane and learn MIDI for: %1. Learning replaces this CC's learned assignments."), control->desc ().label));
+	refresh_midi_mappings ();
+}
+
+void
+PlugUIBase::learn_last_parameter ()
+{
+	if (!show_last_parameter ()) {
+		return;
+	}
+	if (_learn_binding.start_learning ()) {
+		return;
+	}
+	ArdourMessageDialog message (dynamic_cast<Gtk::Window*> (_learn_button.get_toplevel ()), _("MIDI learn is unavailable. Enable Generic MIDI in Preferences > Control Surfaces and connect your controller to its input."), false, Gtk::MESSAGE_WARNING);
+	message.run ();
+}
+
+bool
+PlugUIBase::show_last_parameter ()
+{
+	auto control = std::dynamic_pointer_cast<AutomationControl> (_learn_binding.get_controllable ());
+	if (!_pi || !control) {
+		ArdourMessageDialog message (dynamic_cast<Gtk::Window*> (_learn_button.get_toplevel ()), _("Tweak a plugin parameter first."));
+		message.run ();
+		return false;
+	}
+
+	Route* owner = dynamic_cast<Route*> (_pi->owner ());
+	std::shared_ptr<Route> route;
+	if (owner) {
+		route = std::dynamic_pointer_cast<Route> (owner->shared_from_this ());
+	}
+	RouteTimeAxisView* view = route ? PublicEditor::instance ().rtav_from_route (route) : nullptr;
+	if (!view || !view->show_automation_lane (control)) {
+		ArdourMessageDialog message (dynamic_cast<Gtk::Window*> (_learn_button.get_toplevel ()), _("Cannot show the automation lane for this plugin parameter."), false, Gtk::MESSAGE_WARNING);
+		message.run ();
+		return false;
+	}
+	return true;
+}
+
+bool
+PlugUIBase::learn_menu (GdkEventButton* event)
+{
+	if (event->button != 3 || !_pi) {
+		return false;
+	}
+	using namespace Menu_Helpers;
+	_learn_menu.items ().clear ();
+	_learn_menu.items ().push_back (MenuElem (_("Show lane only"), sigc::hide_return (sigc::mem_fun (*this, &PlugUIBase::show_last_parameter))));
+	_learn_menu.items ().back ().set_sensitive ((bool) _learn_binding.get_controllable ());
+	_learn_menu.items ().push_back (MenuElem (_("Forget this parameter"), sigc::mem_fun (*this, &PlugUIBase::forget_last_parameter)));
+	std::vector<Controllable::MidiBinding> bindings;
+	Controllable::MidiBindings (bindings);
+	bool mapped = false;
+	for (auto const& binding : bindings) {
+		mapped = mapped || binding.control.lock () == _learn_binding.get_controllable ();
+	}
+	_learn_menu.items ().back ().set_sensitive (mapped);
+	_learn_menu.show_all ();
+	_learn_menu.popup (event->button, event->time);
+	return true;
+}
+
+void
+PlugUIBase::forget_last_parameter ()
+{
+	auto control = _learn_binding.get_controllable ();
+	_learn_binding.set_controllable (control);
+	remove_midi_mapping (control);
+}
+
+void
+PlugUIBase::remove_midi_mapping (std::shared_ptr<Controllable> control)
+{
+	if (!control || !_pi) {
+		return;
+	}
+	if (!Controllable::UnmapMidi (control)) {
+		ArdourMessageDialog message (dynamic_cast<Gtk::Window*> (_learn_button.get_toplevel ()), _("Cannot remove the MIDI mapping. Enable Generic MIDI in Preferences > Control Surfaces."), false, Gtk::MESSAGE_WARNING);
+		message.run ();
+		return;
+	}
+	auto automation = std::dynamic_pointer_cast<AutomationControl> (control);
+	if (!automation) {
+		refresh_midi_mappings ();
+		return;
+	}
+	for (auto const& route : *_pi->session ().get_routes ()) {
+		if (route->automation_control_recurse (control->id ()) != automation) {
+			continue;
+		}
+		auto view = PublicEditor::instance ().rtav_from_route (route);
+		if (view) {
+			view->hide_automation_lane (automation);
+		}
+	}
+	refresh_midi_mappings ();
+}
+
+void
+PlugUIBase::midi_plugin_target (std::weak_ptr<Processor> processor, std::shared_ptr<AutomationControl> control, std::string& label)
+{
+	auto insert = std::dynamic_pointer_cast<PluginInsert> (processor.lock ());
+	if (!insert || insert->automation_control_recurse (control->id ()) != control) {
+		return;
+	}
+	label = insert->name () + " / " + control->desc ().label;
+}
+
+std::string
+PlugUIBase::midi_mapping_target (std::shared_ptr<Controllable> control)
+{
+	auto automation = std::dynamic_pointer_cast<AutomationControl> (control);
+	if (!_pi || !automation) {
+		return "";
+	}
+	for (auto const& route : *_pi->session ().get_routes ()) {
+		if (route->automation_control_recurse (control->id ()) != automation) {
+			continue;
+		}
+		std::string label = automation->desc ().label;
+		route->foreach_processor (std::bind (&PlugUIBase::midi_plugin_target, this, _1, automation, std::ref (label)));
+		return route->name () + " / " + label;
+	}
+	return "";
+}

+bool
+BindingProxy::start_learning ()
+{
+	learning_finished ();
+	if (!controllable || !Controllable::StartLearning (controllable)) {
+		return false;
+	}
+
+	if (!prompter) {
+		prompter = new PopUp (Gtk::WIN_POS_MOUSE, 30000, false);
+		prompter->signal_unmap_event().connect (mem_fun (*this, &BindingProxy::prompter_hiding));
+	}
+	prompter->set_text (_("operate controller now"));
+	controllable->LearningFinished.connect (learning_connection, invalidator (*this), std::bind (&BindingProxy::learning_finished, this), gui_context ());
+	prompter->touch ();
+	return true;
+}
+
 void
 BindingProxy::learning_finished ()
 {
 	learning_connection.disconnect ();
-	if (prompter) {
-		prompter->touch (); // hides popup
+	if (prompter && prompter->get_visible ()) {
+		prompter->touch ();
 	}
 }
 

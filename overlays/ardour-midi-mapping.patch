+	}
+	return std::to_string (iface);
+}
+
+class MidiMappingRange : public Gtk::DrawingArea
+{
+public:
+	MidiMappingRange (float low, float high) : _low (low), _high (high) {
+		set_size_request (260, 36);
+		set_can_focus (true);
+		add_events (Gdk::BUTTON_PRESS_MASK | Gdk::BUTTON_RELEASE_MASK | Gdk::POINTER_MOTION_MASK | Gdk::KEY_PRESS_MASK);
+		set_tooltip (*this, _("Drag either handle. Blue = MIDI 0, orange = MIDI 127. Cross handles to invert. Space switches handles; arrows adjust; Escape cancels a drag."));
+	}
+	~MidiMappingRange () { finish (); }
+	sigc::signal<void> begin;
+	sigc::signal<void, float, float, float> changed;
+	sigc::signal<void> finished;
+
+protected:
+	bool on_expose_event (GdkEventExpose*) override {
+		auto cr = get_window ()->create_cairo_context ();
+		auto background = get_style ()->get_bg (Gtk::STATE_NORMAL);
+		cr->set_source_rgb (background.get_red_p (), background.get_green_p (), background.get_blue_p ());
+		cr->paint ();
+		const double y = get_allocation ().get_height () / 2.0;
+		const double span = std::max (1, get_allocation ().get_width () - 24);
+		cr->set_line_width (4);
+		cr->set_source_rgb (0.4, 0.4, 0.4);
+		cr->move_to (12, y);
+		cr->line_to (12 + span, y);
+		cr->stroke ();
+		cr->set_source_rgb (0.3, 0.65, 0.8);
+		cr->move_to (12 + _low * span, y);
+		cr->line_to (12 + _high * span, y);
+		cr->stroke ();
+		for (int handle = 0; handle < 2; ++handle) {
+			const bool low = handle == 0;
+			cr->set_source_rgb (low ? 0.25 : 1.0, low ? 0.7 : 0.65, low ? 1.0 : 0.25);
+			cr->arc (12 + (low ? _low : _high) * span, y, 8, 0, 2 * M_PI);
+			cr->fill_preserve ();
+			cr->set_source_rgb (0.95, 0.95, 0.95);
+			cr->set_line_width (has_focus () && low == _active_low ? 2.5 : 1.0);
+			cr->stroke ();
+		}
+		return true;
+	}
+	bool on_button_press_event (GdkEventButton* event) override {
+		if (event->button != 1) {
+			return false;
+		}
+		grab_focus ();
+		const float position = pointer_value (event->x);
+		_active_low = std::fabs (position - _low) < std::fabs (position - _high);
+		if (_low == _high) {
+			_active_low = !_last_low;
+		}
+		_last_low = _active_low;
+		_initial_low = _low;
+		_initial_high = _high;
+		_dragging = true;
+		add_modal_grab ();
+		begin.emit ();
+		move (position);
+		return true;
+	}
+	bool on_motion_notify_event (GdkEventMotion* event) override {
+		if (!_dragging) {
+			return false;
+		}
+		move (pointer_value (event->x));
+		return true;
+	}
+	bool on_button_release_event (GdkEventButton* event) override {
+		if (!_dragging || event->button != 1) {
+			return false;
+		}
+		move (pointer_value (event->x));
+		finish ();
+		return true;
+	}
+	bool on_key_press_event (GdkEventKey* event) override {
+		if (event->keyval == GDK_KEY_Escape && _dragging) {
+			_low = _initial_low;
+			_high = _initial_high;
+			changed.emit (_low, _high, _active_low ? _low : _high);
+			queue_draw ();
+			finish ();
+			return true;
+		}
+		if (event->state & (GDK_CONTROL_MASK | GDK_MOD1_MASK | GDK_META_MASK | GDK_SUPER_MASK)) {
+			return false;
+		}
+		if (_dragging) {
+			return true;
+		}
+		if (event->keyval == GDK_KEY_space) {
+			_active_low = !_active_low;
+			queue_draw ();
+			return true;
+		}
+		if (event->keyval != GDK_KEY_Left && event->keyval != GDK_KEY_Right && event->keyval != GDK_KEY_Home && event->keyval != GDK_KEY_End) {
+			return false;
+		}
+		const float step = event->state & GDK_SHIFT_MASK ? 0.01f : 0.001f;
+		float value = (_active_low ? _low : _high) + (event->keyval == GDK_KEY_Left ? -step : step);
+		if (event->keyval == GDK_KEY_Home) {
+			value = 0.0f;
+		}
+		if (event->keyval == GDK_KEY_End) {
+			value = 1.0f;
+		}
+		begin.emit ();
+		move (value);
+		finished.emit ();
+		return true;
+	}
+	void on_unmap () override {
+		finish ();
+		Gtk::DrawingArea::on_unmap ();
+	}
+
+private:
+	float _low;
+	float _high;
+	float _initial_low = 0.0f;
+	float _initial_high = 1.0f;
+	bool _active_low = true;
+	bool _last_low = false;
+	bool _dragging = false;
+	float pointer_value (double x) const {
+		return std::max (0.0f, std::min (1.0f, (float) ((x - 12) / std::max (1, get_allocation ().get_width () - 24))));
+	}
+	void move (float value) {
+		float& endpoint = _active_low ? _low : _high;
+		endpoint = std::max (0.0f, std::min (1.0f, value));
+		changed.emit (_low, _high, endpoint);
+		queue_draw ();
+	}
+	void finish () {
+		if (!_dragging) {
+			return;
+		}
+		_dragging = false;
+		remove_modal_grab ();
+		finished.emit ();
+	}
+};
+
+static std::string
+midi_ellipsize (std::string const& text, size_t maxlen)
+{
+	if (maxlen == 0 || text.size () <= maxlen) {
+		return text;
+	}
+	size_t cut = maxlen;
+	while (cut > 0 && (text[cut] & 0xC0) == 0x80) {
+		--cut;
+	}
+	return text.substr (0, cut) + "...";
+}
+
+void
+PlugUIBase::build_midi_mapping_group (MidiMappingSource const& source, std::vector<Controllable::MidiBinding> const& bindings)
+{
+	auto& group = _midi_groups[source];
+	auto expander = Gtk::manage (new Gtk::Expander ());
+	_midi_expanders[source] = expander;
+	auto header = Gtk::manage (new Gtk::HBox (false, 8));
+	const std::string base_title = std::get<1> (source) == MIDI::controller ? string_compose (_("Channel %1 / CC %2"), std::get<0> (source) + 1, std::get<2> (source)) : group.label;
+	std::string parameters;
+	for (auto const& binding : bindings) {
+		auto mapped = binding.control.lock ();
+		if (!mapped) {
+			continue;
+		}
+		if (!parameters.empty ()) {
+			parameters += ", ";
+		}
+		parameters += midi_mapping_target (mapped);
+	}
+	const std::string full_title = base_title + (parameters.empty () ? "" : ": " + parameters);
+	auto label = Gtk::manage (new Gtk::Label (midi_ellipsize (full_title, 120)));
+	label->set_alignment (0.0, 0.5);
+	label->set_ellipsize (Pango::ELLIPSIZE_END);
+	set_tooltip (*label, full_title);
+	auto count = Gtk::manage (new Gtk::Label (string_compose (_("Mapped: %1"), bindings.size ())));
+	auto add = Gtk::manage (new Gtk::Button (_("Add last tweaked")));
+	add->set_can_focus (true);
+	add->signal_clicked ().connect ([this, source] {
+		Glib::signal_idle ().connect_once (sigc::bind (sigc::mem_fun (*this, &PlugUIBase::add_last_midi_parameter), source));
+	});
+	_midi_add_buttons.push_back ({add, source});
+	auto title_box = Gtk::manage (new Gtk::HBox (false, 8));
+	title_box->pack_start (*label, true, false);
+	title_box->pack_start (*count, false, false);
+	expander->set_label_widget (*title_box);
+	expander->set_expanded (group.expanded);
+	header->pack_start (*expander, true, true);
+	header->pack_end (*add, false, false);
+	auto body = Gtk::manage (new Gtk::VBox (false, 12));
+	body->set_border_width (8);
+	expander->property_expanded ().signal_changed ().connect ([this, source, expander, body] {
+		_midi_groups[source].expanded = expander->get_expanded ();
+		body->set_visible (expander->get_expanded ());
+	});
+	for (auto const& binding : bindings) {
+		auto control = binding.control.lock ();
+		if (!control) {
+			continue;
+		}
+		build_midi_mapping_row (*body, control, midi_mapping_target (control), binding.low, binding.high);
+	}
+	if (bindings.empty ()) {
+		auto empty = Gtk::manage (new Gtk::Label (_("No parameters mapped. Add last tweaked to reuse this CC.")));
+		body->pack_start (*empty, false, false, 4);
+	}
+	auto group_box = Gtk::manage (new Gtk::VBox (false, 2));
+	group_box->pack_start (*header, false, false);
+	group_box->pack_start (*body, false, false);
+	body->show_all ();
+	body->set_no_show_all (true);
+	body->set_visible (group.expanded);
+	_midi_rows.pack_start (*group_box, false, false, 4);
+}
+
+void
+PlugUIBase::build_midi_mapping_row (Gtk::VBox& body, std::shared_ptr<Controllable> control, std::string const& target, float low, float high)
+{
+	auto card = Gtk::manage (new Gtk::VBox (false, 2));
+	auto header = Gtk::manage (new Gtk::HBox (false, 4));
+	auto target_label = Gtk::manage (new Gtk::Label (target));
+	target_label->set_alignment (0.0, 0.5);
+	target_label->set_ellipsize (Pango::ELLIPSIZE_END);
+	set_tooltip (*target_label, target);
+	header->pack_start (*target_label, true, true);
+	auto replace = Gtk::manage (new Gtk::Button (_("Replace with last tweaked")));
+	replace->signal_clicked ().connect ([this, control] {
+		Glib::signal_idle ().connect_once (sigc::bind (sigc::mem_fun (*this, &PlugUIBase::replace_last_midi_parameter), control));
+	});
+	_midi_replace_buttons.push_back ({replace, control});
+	header->pack_start (*replace, false, false);
+	auto remove = Gtk::manage (new Gtk::Button (_("Remove")));
+	remove->signal_clicked ().connect ([this, control] {
+		Glib::signal_idle ().connect_once (sigc::bind (sigc::mem_fun (*this, &PlugUIBase::remove_midi_mapping), control));
+	});
+	header->pack_end (*remove, false, false);
+	auto low_value = Gtk::manage (new Gtk::Label (string_compose (_("MIDI 0: %1"), midi_mapping_value_string (control, low))));
+	auto high_value = Gtk::manage (new Gtk::Label (string_compose (_("MIDI 127: %1"), midi_mapping_value_string (control, high))));
+	low_value->set_alignment (0.0, 0.5);
+	high_value->set_alignment (1.0, 0.5);
+	auto values = Gtk::manage (new Gtk::HBox (false, 4));
+	values->pack_start (*low_value, true, true);
+	values->pack_end (*high_value, true, true);
+	auto range = Gtk::manage (new MidiMappingRange (low, high));
+	range->begin.connect ([control] { Controllable::BeginMidiRange (control); });
+	range->finished.connect ([] { Controllable::EndMidiRange (); });
+	range->changed.connect ([this, control, low_value, high_value] (float a, float b, float preview) {
+		if (!change_midi_range (control, *low_value, *high_value, a, b)) {
+			return;
+		}
+		preview_midi_mapping_value (control, preview);
+	});
+	card->pack_start (*header, false, false);
+	card->pack_start (*range, false, false);
+	card->pack_start (*values, false, false);
+	body.pack_start (*card, false, false);
+}
+
+bool
+PlugUIBase::change_midi_range (std::shared_ptr<Controllable> control, Gtk::Label& low_label, Gtk::Label& high_label, float low, float high)
+{
+	if (!Controllable::MapMidiRange (control, low, high)) {
+		PBD::error << "Cannot change MIDI mapping range: Generic MIDI or the mapping is unavailable" << endmsg;
+		return false;
+	}
+	low_label.set_text (string_compose (_("MIDI 0: %1"), midi_mapping_value_string (control, low)));
+	high_label.set_text (string_compose (_("MIDI 127: %1"), midi_mapping_value_string (control, high)));
+	return true;
+}
+
+std::shared_ptr<Controllable>
+PlugUIBase::last_midi_parameter ()
+{
+	auto control = std::dynamic_pointer_cast<AutomationControl> (_last_midi_parameter.lock ());
+	if (!control || control->parameter ().type () != PluginAutomation || (control->flags () & Controllable::NotAutomatable) || midi_mapping_target (control).empty ()) {
+		return std::shared_ptr<Controllable> ();
+	}
+	return control;
+}
+
+void
+PlugUIBase::open_last_tweaked_group ()
+{
+	std::vector<Controllable::MidiBinding> bindings;
+	Controllable::MidiBindings (bindings);
+	auto last = last_midi_parameter ();
+	MidiMappingSource found;
+	bool have_group = false;
+	for (auto const& binding : bindings) {
+		if (last && binding.control.lock () == last) {
+			found = MidiMappingSource (binding.channel, binding.event, binding.number);
+			have_group = true;
+			break;
+		}
+	}
+	if (!have_group) {
+		return;
+	}
+	if (_midi_expanders.empty ()) {
+		// window not built yet: seed the state for the upcoming build
+		for (auto& entry : _midi_groups) {
+			entry.second.expanded = false;
+		}
+		_midi_groups[found].expanded = true;
+		return;
+	}
+	for (auto& entry : _midi_expanders) {
+		entry.second->set_expanded (entry.first == found);
+	}
+}
+
+void
+PlugUIBase::refresh_midi_last_tweaked ()
+{
+	auto control = last_midi_parameter ();
+	const std::string target = control ? midi_mapping_target (control) : _("none. Tweak a plugin parameter.");
+	_midi_last_tweaked.set_text (string_compose (_("Last tweaked: %1"), target));
+	set_tooltip (_midi_last_tweaked, target);
+	std::vector<Controllable::MidiBinding> bindings;
+	Controllable::MidiBindings (bindings);
+	auto existing = std::find_if (bindings.begin (), bindings.end (), [control] (Controllable::MidiBinding const& binding) { return binding.control.lock () == control; });
+	for (auto const& entry : _midi_add_buttons) {
+		const bool already = existing != bindings.end () && MidiMappingSource (existing->channel, existing->event, existing->number) == entry.second;
+		entry.first->set_sensitive (control && !already && std::get<1> (entry.second) == MIDI::controller);
+		set_tooltip (*entry.first, already ? _("Already mapped to this CC") : string_compose (_("Add last tweaked: %1. Moves its previous assignment here, preserving its range."), target));
+	}
+	for (auto const& entry : _midi_replace_buttons) {
+		entry.first->set_sensitive (control && entry.second.lock () != control);
+		set_tooltip (*entry.first, string_compose (_("Replace with last tweaked: %1. Preserves this row's MIDI source and range."), target));
+	}
+}
+
+void
+PlugUIBase::add_last_midi_parameter (MidiMappingSource source)
+{
+	auto control = last_midi_parameter ();
+	if (control && std::get<1> (source) == MIDI::controller && Controllable::MapMidiCC (control, std::get<0> (source), std::get<2> (source))) {
+		return;
+	}
+	ArdourMessageDialog message (_midi_dialog.get (), _("Cannot add last tweaked. Tweak an available plugin parameter and enable Generic MIDI."), false, Gtk::MESSAGE_WARNING);
+	message.run ();
+}
+
+void
+PlugUIBase::replace_last_midi_parameter (std::shared_ptr<Controllable> previous)
+{
+	auto target = last_midi_parameter ();
+	if (target && Controllable::RetargetMidi (previous, target)) {
+		return;
+	}
+	ArdourMessageDialog message (_midi_dialog.get (), _("Cannot replace this mapping. The parameter or mapping may have been removed, or Generic MIDI is disabled."), false, Gtk::MESSAGE_WARNING);
+	message.run ();
+}

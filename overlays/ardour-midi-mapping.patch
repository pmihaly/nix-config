+void
+PlugUIBase::show_midi_mappings ()
+{
+	if (!_pi) {
+		return;
+	}
+	if (!_midi_dialog) {
+		_midi_dialog.reset (new Gtk::Dialog (_("Learned MIDI Mappings")));
+		_midi_dialog->set_default_size (780, 460);
+		auto parent = dynamic_cast<Gtk::Window*> (_learn_button.get_toplevel ());
+		if (parent) {
+			_midi_dialog->set_transient_for (*parent);
+		}
+		_midi_rows.set_spacing (8);
+		_midi_rows.set_border_width (4);
+		_midi_scroll.set_policy (Gtk::POLICY_AUTOMATIC, Gtk::POLICY_AUTOMATIC);
+		_midi_scroll.add (_midi_rows);
+		_midi_last_tweaked.set_alignment (0.0, 0.5);
+		_midi_last_tweaked.set_ellipsize (Pango::ELLIPSIZE_END);
+		_midi_dialog->get_vbox ()->pack_start (_midi_last_tweaked, false, false, 8);
+		_midi_dialog->get_vbox ()->pack_start (_midi_scroll);
+		_midi_dialog->add_button (Gtk::Stock::CLOSE, Gtk::RESPONSE_CLOSE);
+		_midi_dialog->signal_response ().connect (sigc::mem_fun (*this, &PlugUIBase::midi_mapping_response));
+		_midi_dialog->signal_delete_event ().connect ([this] (GdkEventAny*) {
+			midi_mapping_response (Gtk::RESPONSE_CLOSE);
+			return true;
+		});
+	}
+	_midi_dialog->show_all ();
+	refresh_midi_mappings ();
+	_midi_dialog->present ();
+}
+
+void
+PlugUIBase::midi_mapping_response (int response)
+{
+	if (!_midi_dialog) {
+		return;
+	}
+	_midi_dialog->hide ();
+	_midi_groups.clear ();
+	_midi_rows_key.clear ();
+	_midi_add_buttons.clear ();
+	_midi_replace_buttons.clear ();
+	_midi_expanders.clear ();
+}
+
+void
+PlugUIBase::refresh_midi_mappings ()
+{
+	if (!_pi) {
+		return;
+	}
+	std::vector<Controllable::MidiBinding> bindings;
+	Controllable::MidiBindings (bindings);
+	std::string status;
+	for (auto const& binding : bindings) {
+		if (binding.control.lock () == _learn_binding.get_controllable ()) {
+			status = string_compose (_("Mapped: %1"), binding.source);
+		}
+	}
+	_learn_status.set_text (status);
+	set_tooltip (_learn_status, status);
+	if (!_midi_dialog || !_midi_dialog->get_visible ()) {
+		return;
+	}
+
+	refresh_midi_last_tweaked ();
+	const bool first_build = _midi_groups.empty ();
+	std::map<MidiMappingSource, std::vector<Controllable::MidiBinding>> grouped;
+	std::string key = "groups;";
+	for (auto const& binding : bindings) {
+		auto control = binding.control.lock ();
+		const std::string target = midi_mapping_target (control);
+		if (!control || target.empty ()) {
+			continue;
+		}
+		MidiMappingSource source (binding.channel, binding.event, binding.number);
+		_midi_groups[source].label = binding.source;
+		grouped[source].push_back (binding);
+		key += control->id ().to_s () + ':' + binding.source + ':' + target;
+		key += string_compose (":%1:%2;", binding.low, binding.high);
+	}
+	if (first_build) {
+		open_last_tweaked_group ();
+	}
+	if (key == _midi_rows_key) {
+		return;
+	}
+	_midi_rows_key = key;
+	_midi_add_buttons.clear ();
+	_midi_replace_buttons.clear ();
+	_midi_expanders.clear ();
+	const double scroll = _midi_scroll.get_vadjustment ()->get_value ();
+	for (auto child : _midi_rows.get_children ()) {
+		_midi_rows.remove (*child);
+		delete child;
+	}
+	for (auto const& group : _midi_groups) {
+		build_midi_mapping_group (group.first, grouped[group.first]);
+	}
+	if (_midi_groups.empty ()) {
+		Gtk::Label* empty = Gtk::manage (new Gtk::Label (_("Tweak a plugin parameter, click Learn, then move a MIDI controller to create a group.")));
+		empty->set_line_wrap (true);
+		_midi_rows.pack_start (*empty, false, false, 8);
+	}
+	_midi_rows.show_all ();
+	_midi_scroll.get_vadjustment ()->set_value (scroll);
+	refresh_midi_last_tweaked ();
+}
+
+void
+PlugUIBase::preview_midi_mapping_value (std::shared_ptr<Controllable> control, float iface)
+{
+	if (!control) {

+			delta->add_child_nocopy (*new XMLNode (*current));
+			continue;
+		}
+		auto removed = new XMLNode ("Removed");
+		removed->set_property ("id", entry.first);
+		delta->add_child_nocopy (*removed);
 	}
+	return delta;

+static std::unique_ptr<XMLNode>
+midi_mapping_delta (XMLNode const& state, XMLNode const& other, std::string const& only_parameter)
+{
+	std::map<std::string, std::pair<XMLNode const*, XMLNode const*>> mappings;
+	for (auto node : state.children ()) {
+		std::string id;
+		node->get_property ("id", id);
+		mappings[id].first = node;
+	}
+	for (auto node : other.children ()) {
+		std::string id;
+		node->get_property ("id", id);
+		mappings[id].second = node;
+	}
+	auto delta = std::unique_ptr<XMLNode> (new XMLNode ("MidiMappings"));
+	for (auto const& entry : mappings) {
+		if (!only_parameter.empty () && entry.first != only_parameter) {
+			continue;
+		}
+		auto current = entry.second.first;
+		auto previous = entry.second.second;
+		if (current && previous && *current == *previous) {
+			continue;
 		}
-		i = tmp;

+    def conv_vrc(self, abspath: str, tpath: str, fmt: str, vn: VFS) -> None:
+        # video-track conversions, requested with ?th=<fmt>[:<N>]:
+        #   json    -> stream metadata as json
+        #   mp4[:N] -> mp4 (remux or transcode) with audio track N
+        #   vtt[:N] -> webvtt of subtitle track N
+        idx = 0
+        have_idx = False
+        if ":" in fmt:
+            fmt, skel = fmt.split(":", 1)
+            try:
+                idx = int(skel)
+            except:
+                raise Exception("invalid track index in %r" % (fmt,))
+            have_idx = True
+
+        self.wait4ram(0.5, tpath)
+        try:
+            _, _, strms, fprops = ffprobe(abspath, int(vn.flags["vrc"] / 5))
+        except:
+            if fmt != "json":
+                raise
+            return
+
+        def _strms(typ):
+            return [s for s in strms[1:] if s.get("codec_type") == typ]
+
+        aidx = _strms("audio")
+        sidx = _strms("subtitle")
+        vidx = [
+            s
+            for s in _strms("video")
+            if s.get("DISPOSITION:attached_pic") != "1"
+        ]
+
+        # text subtitle streams, as (index-within-subtitles, stream) pairs;
+        # the index is what ?th=vtt:<N> uses and what the json "s" list
+        # exposes, while ffmpeg maps the original 0:s:<N> stream
+        subs = [
+            (si, s)
+            for si, s in enumerate(sidx)
+            if s.get("codec_name")
+            in ("mov_text", "subrip", "srt", "webvtt", "ass", "ssa", "text")
+        ]
+
+        bap_in = fsenc(abspath)
+        bap_out = fsenc(tpath)
+
+        if fmt == "json":
+            doc = {}
+            if vidx:
+                doc["v"] = [
+                    {
+                        "c": s.get("codec_name"),
+                        "w": s.get("width"),
+                        "h": s.get("height"),
+                        "fr": s.get("r_frame_rate"),
+                    }
+                    for s in vidx
+                ]
+            if aidx:
+                doc["a"] = [
+                    {
+                        "c": s.get("codec_name"),
+                        "l": s.get("TAG:language"),
+                        "t": s.get("TAG:title"),
+                        "ch": s.get("channel_layout"),
+                    }
+                    for s in aidx
+                ]
+            if subs:
+                doc["s"] = [
+                    {
+                        "c": s.get("codec_name"),
+                        "l": s.get("TAG:language"),
+                        "t": s.get("TAG:title"),
+                    }
+                    for _si, s in subs
+                ]
+            if fprops.get("duration"):
+                try:
+                    doc["d"] = float(fprops["duration"])
+                except:
+                    pass
+            if fprops.get("format_name"):
+                doc["f"] = fprops["format_name"]
+            if not doc:
+                return
+            with open(tpath, "wb") as f:
+                f.write(
+                    json.dumps(doc, separators=(",", ":"), sort_keys=True).encode(
+                        "utf-8"
+                    )
+                )
+            return
+
+        if fmt == "vtt":
+            if idx >= len(subs):
+                raise Exception("no subtitle track %d" % (idx,))
+            si, _s = subs[idx]
+            # fmt: off
+            cmd = bwrap(HAVE_FFMPEG[0], bap_in, bap_out) + [
+                b"-nostdin",
+                b"-v", b"error",
+                b"-hide_banner",
+                b"-i", bap_in,
+                b"-map", ("0:s:%d" % (si,)).encode("ascii"),
+                b"-c:s", b"webvtt",
+                bap_out,
+            ]
+            # fmt: on
+            self._run_ff(cmd, vn, "vrc")
+            return
+
+        if fmt == "mp4":
+            if not vidx:
+                raise Exception("no video stream")
+            v0 = vidx[0]
+            has_a = not have_idx or idx < len(aidx)
+            if have_idx and not has_a:
+                raise Exception("no audio track %d" % (idx,))
+            if not have_idx:
+                idx = 0 if aidx else -1
+                has_a = idx >= 0
+            acodec = aidx[idx].get("codec_name") or "" if has_a else ""
+            vcopy = v0.get("codec_name") in ("h264", "hevc", "mpeg4", "av1")
+            # copy the audio only if every major browser can decode it
+            # (aac, mp3); everything else (flac, ac3, eac3, alac, ...) is
+            # transcoded to aac -- e.g. eac3 remuxes into mp4 fine but
+            # phones cannot decode it (silent video, volume control dead)
+            acopy = has_a and acodec in ("aac", "mp3")
+
+            vmap = ("0:%s" % (v0.get("index") or "0",)).encode("ascii")
+            cmd = [
+                b"-nostdin",
+                b"-v", b"error",
+                b"-hide_banner",
+                b"-i", bap_in,
+                b"-map", vmap,
+            ]
+            if has_a:
+                cmd += [b"-map", ("0:a:%d" % (idx,)).encode("ascii")]
+            else:
+                cmd += [b"-an"]
+
+            if vcopy and acopy:
+                enc = [b"-c", b"copy"]
+            elif vcopy:
+                enc = [b"-c:v", b"copy", b"-c:a", b"aac", b"-b:a", b"192k", b"-ar", b"48000"]
+            else:
+                enc = [
+                    b"-c:v", b"libx264", b"-preset", b"veryfast", b"-crf", b"23",
+                    b"-pix_fmt", b"yuv420p",
+                    b"-c:a", b"aac", b"-b:a", b"192k", b"-ar", b"48000",
+                ]
+
+            self.log("conv vrc %s %s" % (fmt, b" ".join(enc).decode("ascii")), 6)
+            cmd += enc + [b"-movflags", b"+faststart", bap_out]
+            self._run_ff(bwrap(HAVE_FFMPEG[0], bap_in, bap_out) + cmd, vn, "vrc", oom=800)
+            return
+
+        raise Exception("unknown vrc format %r" % (fmt,))
